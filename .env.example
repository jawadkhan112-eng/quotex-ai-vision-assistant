# GEMINI_API_KEY: Required for Gemini Vision API calls.
# Set this in Vercel Project Settings -> Environment Variables.
GEMINI_API_KEY="AIzaSyTestPlaceholderKey123"

# GROQ_API_KEY: High-speed LLM inference
GROQ_API_KEY="gsk_test_placeholder"

# OPENROUTER_API_KEY: Unified multi-model routing
OPENROUTER_API_KEY="sk-or-v1-test-placeholder"

# GEMINI_MODEL: Default model for vision & chat analysis.
# Options: gemini-2.5-flash (Recommended fast vision), gemini-3.8-flash, gemini-2.5-pro
GEMINI_MODEL="gemini-2.5-flash"
GROQ_MODEL="llama-3.3-70b-versatile"
OPENROUTER_MODEL="google/gemini-2.0-flash-exp:free"

# AI_PROVIDER: Initial vision AI provider.
AI_PROVIDER="gemini"

# ENCRYPTION_MASTER_SECRET: Secret for AES-256-GCM server-side key vault.
ENCRYPTION_MASTER_SECRET="your_secure_master_secret_key_change_in_production"

# OTCharts API configuration
OTCHARTS_API_KEY=""
OTCHARTS_BASE_URL="https://api.otcharts.com/v1"
OTCHARTS_DEFAULT_BOOK="otc"

# DATABASE_URL: SQLite or persistent database connection string (e.g. postgres://... for Neon/PostgreSQL).
DATABASE_URL="sqlite://./data/quotex_vision.db"

# APP_URL: The hosting URL where this application is deployed.
APP_URL="https://quotex-ai-vision-assistant.vercel.app"

# SESSION_SECRET: Secret key for server-side session encryption.
SESSION_SECRET="your_random_session_secret_key_change_in_production"
