# GEMINI_API_KEY: Required for Gemini Vision API calls.
# Set this in Vercel Project Settings -> Environment Variables.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# GEMINI_MODEL: Default model for vision & chat analysis.
# Options: gemini-3.8-flash (Recommended), gemini-4-argon, gemini-3.1-flash-lite
GEMINI_MODEL="gemini-3.8-flash"

# AI_PROVIDER: Initial vision AI provider.
AI_PROVIDER="gemini"

# DATABASE_URL: SQLite or persistent database connection string.
DATABASE_URL="sqlite://./data/quotex_vision.db"

# APP_URL: The hosting URL where this application is deployed.
APP_URL="https://quotex-ai-vision-assistant.vercel.app"

# SESSION_SECRET: Secret key for server-side session encryption.
SESSION_SECRET="your_random_session_secret_key_change_in_production"
